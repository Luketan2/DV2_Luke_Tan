{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map of businesses per 1,000 residents in each SA4 region (June 2025), with insets for the eight capital cities and an industry filter. Sources: ABS 8165.0 data cube 8 (SA2 counts, June 2025) aggregated to SA4; ABS 3218.0 Regional population 2024-25; ABS ASGS 2021 boundaries.",
  "data": {
    "url": "data/sa4_industry.csv",
    "format": {
      "type": "csv",
      "parse": {
        "per_1000": "number",
        "total": "number",
        "sa4": "number"
      }
    }
  },
  "params": [
    {
      "name": "industry",
      "value": "All industries",
      "bind": {
        "input": "select",
        "name": "Show businesses in: ",
        "options": [
          "All industries",
          "Construction",
          "Professional services",
          "Real estate & rental",
          "Transport & delivery",
          "Health care",
          "Agriculture",
          "Retail",
          "Finance & insurance",
          "Other services",
          "Admin & support",
          "Hospitality",
          "Manufacturing",
          "Wholesale",
          "Education",
          "Arts & recreation",
          "Media & telco",
          "Utilities",
          "Mining",
          "Public admin"
        ]
      }
    }
  ],
  "spacing": 36,
  "hconcat": [
    {
      "width": 537,
      "height": 420,
      "title": {
        "text": "Australia",
        "fontSize": 13,
        "anchor": "start"
      },
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -132,
          0
        ]
      },
      "transform": [
        {
          "filter": "datum.industry == industry"
        },
        {
          "window": [
            {
              "op": "ntile",
              "param": 5,
              "as": "q"
            }
          ],
          "sort": [
            {
              "field": "per_1000"
            }
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "per_1000",
              "as": "qmin"
            },
            {
              "op": "max",
              "field": "per_1000",
              "as": "qmax"
            }
          ],
          "groupby": [
            "q"
          ]
        },
        {
          "calculate": "datum.q + '|' + format(datum.qmin, datum.qmax < 10 ? '.1f' : '.0f') + ' – ' + format(datum.qmax, datum.qmax < 10 ? '.1f' : '.0f')",
          "as": "band"
        },
        {
          "lookup": "sa4",
          "from": {
            "data": {
              "url": "data/sa4.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.sa4"
          },
          "as": "geo"
        }
      ],
      "params": [
        {
          "name": "hoverMain",
          "select": {
            "type": "point",
            "fields": [
              "sa4"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#faf8f4",
        "strokeWidth": 0.4
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "band",
          "type": "ordinal",
          "title": "Businesses per 1,000 residents",
          "scale": {
            "range": [
              "#cde2fb",
              "#86b6ef",
              "#3987e5",
              "#1c5cab",
              "#0d366b"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 180,
            "titleLimit": 300,
            "labelExpr": "slice(datum.label, 2)",
            "columns": 5,
            "columnPadding": 14
          }
        },
        "strokeWidth": {
          "condition": {
            "param": "hoverMain",
            "empty": false,
            "value": 2
          },
          "value": 0.4
        },
        "tooltip": [
          {
            "field": "sa4_name",
            "title": "Region (SA4)"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "industry",
            "title": "Industry"
          },
          {
            "field": "total",
            "title": "Businesses",
            "format": ","
          },
          {
            "field": "per_1000",
            "title": "Per 1,000 residents",
            "format": ".1f"
          }
        ]
      }
    },
