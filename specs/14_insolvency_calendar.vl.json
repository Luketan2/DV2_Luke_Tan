{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Calendar heatmap: companies entering insolvency for the first time in each month, July 2019 to August 2026. Rows are financial years, columns are months. Source: ASIC Insolvency statistics Series 1 & 2, Table 1 (published 6 Oct 2026; the latest two months are provisional).",
  "data": {"url": "data/insolvency_monthly.csv"},
  "width": 890,
  "height": 304,
  "encoding": {
    "x": {"field": "month", "type": "ordinal", "title": null, "sort": ["Jul", "Aug", "Sep", "Oct", "Nov", "Dec", "Jan", "Feb", "Mar", "Apr", "May", "Jun"], "axis": {"orient": "top", "labelAngle": 0, "domain": false, "ticks": false}},
    "y": {"field": "fy", "type": "ordinal", "title": null, "axis": {"domain": false, "ticks": false, "labelExpr": "datum.value == '2026-27' ? '2026-27 (so far)' : datum.value"}}
  },
  "layer": [
    {
      "mark": {"type": "rect", "stroke": "#faf8f4", "strokeWidth": 2, "cornerRadius": 3},
      "encoding": {
        "color": {
          "field": "n", "type": "quantitative", "title": "Companies entering insolvency in the month",
          "scale": {"range": ["#fdf1ea", "#f7c8b3", "#ef9a76", "#d9622f", "#9a3412"], "domain": [200, 1850]},
          "legend": {"orient": "bottom", "direction": "horizontal", "gradientLength": 260, "titleLimit": 320}
        },
        "tooltip": [
          {"field": "month", "title": "Month"},
          {"field": "fy", "title": "Financial year"},
          {"field": "n", "title": "Companies", "format": ","}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 10.5},
      "encoding": {
        "text": {"field": "n", "format": ","},
        "color": {"condition": {"test": "datum.n > 1150", "value": "#ffffff"}, "value": "#3a3935"}
      }
    }
  ]
}
