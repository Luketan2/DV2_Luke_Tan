{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "100% stacked bar chart: the mix of business sizes inside each industry (June 2025), sorted from most to fewest sole operators. The 11 industries with at least 4% of all businesses are shown; the rest are grouped. Source: ABS 8165.0 data cube 8, summed nationally.",
  "data": {"url": "data/industry_size_2025.csv"},
  "width": "container",
  "autosize": {"type": "fit-x", "contains": "padding"},
  "height": 300,
  "transform": [
    {"joinaggregate": [{"op": "sum", "field": "n", "as": "rawIndTotal"}], "groupby": ["industry"]},
    {"joinaggregate": [{"op": "sum", "field": "n", "as": "rawAllTotal"}]},
    {"calculate": "datum.rawIndTotal / datum.rawAllTotal >= 0.04 ? datum.industry : 'All other industries'", "as": "grp"},
    {"calculate": "datum.size == 'Non-employing' ? 'None' : datum.size == '1-4' ? '1–4' : '5 or more'", "as": "size3"},
    {"aggregate": [{"op": "sum", "field": "n", "as": "n"}], "groupby": ["grp", "size3"]},

    {"joinaggregate": [{"op": "sum", "field": "n", "as": "indTotal"}], "groupby": ["grp"]},
    {"calculate": "datum.n / datum.indTotal * 100", "as": "pct"},
    {"calculate": "datum.size3 == 'None' ? datum.pct : 0", "as": "soleShare"},
    {"joinaggregate": [{"op": "max", "field": "soleShare", "as": "indSole"}], "groupby": ["grp"]},
    {"calculate": "datum.grp == 'All other industries' ? -1 : datum.indSole", "as": "rowOrder"},
    {"calculate": "indexof(['None', '1–4', '5 or more'], datum.size3)", "as": "sizeOrder"},
    {"window": [{"op": "sum", "field": "pct", "as": "cum"}], "groupby": ["grp"], "sort": [{"field": "sizeOrder"}], "frame": [null, 0]},
    {"calculate": "datum.cum - datum.pct", "as": "x0"}
  ],
  "encoding": {
    "y": {
      "field": "grp", "type": "nominal", "title": null,
      "sort": {"field": "rowOrder", "order": "descending"},
      "axis": {"domain": false, "ticks": false, "labelFontSize": 11.5, "labelPadding": 6}
    }
  },
  "layer": [
    {
      "params": [{"name": "rowHover", "select": {"type": "point", "fields": ["grp"], "on": "pointerover", "clear": "pointerout"}}],
      "mark": {"type": "bar", "stroke": "#faf8f4", "strokeWidth": 1.5, "height": {"band": 0.78}},
      "encoding": {
        "x": {"field": "x0", "type": "quantitative", "title": null, "scale": {"domain": [0, 100]}, "axis": {"values": [0, 25, 50, 75, 100], "labelExpr": "datum.value + '%'", "grid": false, "orient": "top", "domain": false}},
        "x2": {"field": "cum"},
        "color": {
          "field": "size3", "type": "ordinal", "title": "Employees",
          "scale": {"domain": ["None", "1–4", "5 or more"], "range": ["#9ec5f4", "#5598e7", "#104281"]},
          "legend": {"orient": "bottom", "direction": "horizontal", "labelExpr": "datum.label == 'None' ? 'None (sole operators)' : datum.label"}
        },
        "opacity": {"condition": {"param": "rowHover", "empty": true, "value": 1}, "value": 0.4},
        "tooltip": [
          {"field": "grp", "title": "Industry"},
          {"field": "size3", "title": "Employees"},
          {"field": "n", "title": "Businesses", "format": ","},
          {"field": "pct", "title": "Share of the industry (%)", "format": ".0f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.sizeOrder == 0"}, {"calculate": "format(datum.pct, '.0f') + '%'", "as": "lab"}],
      "mark": {"type": "text", "align": "right", "baseline": "middle", "dx": -6, "fontSize": 11, "fontWeight": 700, "color": "#0b2a52"},
      "encoding": {
        "x": {"field": "cum", "type": "quantitative"},
        "text": {"field": "lab"}
      }
    }
  ]
}
